{
  "name": "@designliquido/delegua-arquivos",
  "version": "0.0.4",
  "description": "Biblioteca para acessos a arquivos e diretórios em Delégua",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesignLiquido/delegua-arquivos.git"
  },
  "scripts": {
    "empacotar": "yarn rimraf ./dist && tsc && yarn copyfiles -V ./README.md ./dist && yarn copyfiles -V ./LICENSE ./dist && yarn copyfiles -V ./package.json ./dist",
    "publicar-npm": "npm publish ./dist --access public",
    "testes-unitarios": "jest --runInBand --coverage"
  },
  "author": "Leonel Sanches da Silva",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^20.11.17",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "mock-fs": "^5.5.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
